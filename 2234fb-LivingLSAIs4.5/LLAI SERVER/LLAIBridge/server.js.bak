function stripBracketTags(text) {
  if (!text) return "";
  return text.replace(/\s*\[[A-Za-z0-9_@:]+\]\s*/g, " ").replace(/\s+/g, " ").trim();
}

function normalizeTagCase(text) {
  if (!text) return "";
  return text.replace(/\[([A-Za-z0-9_@:]+)\]/g, (_, t) => `[${t.toUpperCase()}]`);
}

